# Copy to `.env` and fill in the values. Never commit `.env`.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Comma-separated list of allowed browser origins (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5173

# SQLite file. Relative paths are resolved against the `backend/` folder.
DATABASE_PATH=data/course_assistant.db

# --- Authentication (Google OAuth2 + JWT) ---
# OAuth 2.0 Client ID (type "Web application") from Google Cloud Console.
GOOGLE_CLIENT_ID=
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=7200
# Google accounts (comma separated) that receive the `admin` role on login.
ADMIN_EMAILS=

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Used only for the cost estimate shown in the admin dashboard (USD per 1M tokens).
AI_PRICE_INPUT_PER_1M=0.10
AI_PRICE_OUTPUT_PER_1M=0.40

# --- RAG ---
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=3
# Cosine similarity below this value => the assistant refuses to answer.
RAG_MIN_SCORE=0.45

# --- Uploads ---
MAX_UPLOAD_MB=5
