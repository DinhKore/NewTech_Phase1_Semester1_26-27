# Copy to `.env` (or `.env.local`). Vite only exposes variables that start with VITE_.

# Base URL of the backend API.
VITE_API_BASE_URL=http://localhost:3000/api

# OAuth 2.0 Client ID (type "Web application") from Google Cloud Console.
# Add http://localhost:5173 to "Authorized JavaScript origins".
# Must be the SAME value as GOOGLE_CLIENT_ID in backend/.env.
VITE_GOOGLE_CLIENT_ID=

# Client-side upload limit in MB (keep in sync with backend MAX_UPLOAD_MB).
VITE_MAX_UPLOAD_MB=5
